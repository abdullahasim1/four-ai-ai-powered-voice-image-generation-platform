# Neon PostgreSQL connection string (https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Email of the account that gets admin role (must sign up / log in with this email)
ADMIN_EMAIL=admin@example.com

# Email delivery — lib/email.js uses the first configured provider, in this order:
# 1. Gmail SMTP (recommended) — create an App Password at
#    https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 2. Resend HTTP API fallback (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM="Four AI <onboarding@resend.dev>"

# If neither provider is set, verification / reset / email-change links are
# printed to the server console instead of being emailed.

# Hugging Face token for server-side image generation (https://huggingface.co/settings/tokens)
HUGGING_FACE_API_KEY=hf_xxxxxxxxxxxxxxxxxx
